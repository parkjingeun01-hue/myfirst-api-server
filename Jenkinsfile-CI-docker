pipeline {
  agent any

  environment {
    GIT_URL = 'https://github.com/parkjingeun01-hue/myfirst-api-server.git'
    GIT_BRANCH = 'main'
    GIT_ID = 'skala-github-id'
    IMAGE_NAME = 'sk051-webserver'
    IMAGE_TAG = '1.0'
    IMAGE_REGISTRY_URL = 'skala-registry.skala-us.com'
    IMAGE_REGISTRY_PROJECT = 'class-2'
    DOCKER_CREDENTIAL_ID = 'skala-image-registry-id'
    K8S_NAMESPACE = 'class-2'
    GITOPS_BRANCH = 'gitops'
    GITOPS_MANIFEST_DIR = 'kustomize/overlays/dev'
  }

  options {
    disableConcurrentBuilds()
    timestamps()
    skipDefaultCheckout(true)
    timeout(time: 20, unit: 'MINUTES')
  }

  stages {
    stage('Clone Repository') {
      steps {
        git branch: "${GIT_BRANCH}", url: "${GIT_URL}", credentialsId: "${GIT_ID}"
      }
    }

    stage('Build with Maven') {
      steps {
        sh 'mvn -B -s settings.xml clean package -DskipTests'
      }
    }

    stage('Compute Image Meta') {
      steps {
        script {
          env.SOURCE_REV = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          def shortCommit = env.SOURCE_REV.take(7)
          env.FINAL_IMAGE_TAG = "${env.IMAGE_TAG}-dk${env.BUILD_NUMBER}-${shortCommit}"
        }
        echo "Image tag: ${FINAL_IMAGE_TAG}"
      }
    }

    stage('Image Build & Push (BuildKit)') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "${DOCKER_CREDENTIAL_ID}",
          usernameVariable: 'REG_USER',
          passwordVariable: 'REG_PASS'
        )]) {
          sh '''
            set +x
            set -eu
            umask 077
            DOCKER_CONFIG="$(mktemp -d)"
            export DOCKER_CONFIG
            trap 'rm -rf "$DOCKER_CONFIG"' EXIT
            IMAGE_REF="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}:${FINAL_IMAGE_TAG}"
            printf '%s' "$REG_PASS" | docker login -u "$REG_USER" --password-stdin "$IMAGE_REGISTRY_URL"
            docker buildx build --platform linux/amd64 -t "$IMAGE_REF" --push .
          '''
        }
      }
    }

    stage('GitOps Update') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "${GIT_ID}",
          usernameVariable: 'GIT_USER',
          passwordVariable: 'GIT_PASS'
        )]) {
          sh '''
            set +x
            set -eu
            umask 077
            TEMP_DIR="$(mktemp -d)"
            trap 'rm -rf "$TEMP_DIR"' EXIT
            GIT_ASKPASS="$TEMP_DIR/askpass.sh"
            GIT_TERMINAL_PROMPT=0
            export GIT_ASKPASS GIT_TERMINAL_PROMPT
            cat > "$GIT_ASKPASS" <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s' "$GIT_USER" ;;
  *Password*) printf '%s' "$GIT_PASS" ;;
  *) exit 1 ;;
esac
ASKPASS
            chmod 700 "$GIT_ASKPASS"
            IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"

            # Take only versioned manifests from the exact commit that was built.
            mkdir "$TEMP_DIR/source"
            git archive --format=tar -o "$TEMP_DIR/source.tar" "$SOURCE_REV" kustomize
            tar -xf "$TEMP_DIR/source.tar" -C "$TEMP_DIR/source"

            # Preserve the GitOps branch history; never force-push.
            GITOPS_DIR="$TEMP_DIR/gitops"
            git init -q "$GITOPS_DIR"
            git -C "$GITOPS_DIR" remote add origin "$GIT_URL"
            if git -C "$GITOPS_DIR" ls-remote --exit-code --heads origin "refs/heads/${GITOPS_BRANCH}" > "$TEMP_DIR/remote-ref"; then
              git -C "$GITOPS_DIR" fetch --quiet --no-tags origin "refs/heads/${GITOPS_BRANCH}"
              git -C "$GITOPS_DIR" checkout -q -b "$GITOPS_BRANCH" FETCH_HEAD
            else
              result=$?
              test "$result" = 2
              git -C "$GITOPS_DIR" fetch --quiet --no-tags origin "refs/heads/${GIT_BRANCH}"
              git -C "$GITOPS_DIR" checkout -q -b "$GITOPS_BRANCH" "$SOURCE_REV"
            fi

            mkdir -p "$GITOPS_DIR/kustomize"
            cp -R "$TEMP_DIR/source/kustomize/." "$GITOPS_DIR/kustomize/"
            (cd "$GITOPS_DIR/$GITOPS_MANIFEST_DIR" && kustomize edit set image "${IMAGE_BASE}=${IMAGE_BASE}:${FINAL_IMAGE_TAG}")
            kustomize build "$GITOPS_DIR/$GITOPS_MANIFEST_DIR" > "$TEMP_DIR/rendered.yaml"
            grep -Fq "image: ${IMAGE_BASE}:${FINAL_IMAGE_TAG}" "$TEMP_DIR/rendered.yaml"

            git -C "$GITOPS_DIR" config user.name 'sk051-gitops'
            git -C "$GITOPS_DIR" config user.email 'parkjingeun01-hue@users.noreply.github.com'
            git -C "$GITOPS_DIR" add -- kustomize
            if ! git -C "$GITOPS_DIR" diff --cached --quiet; then
              git -C "$GITOPS_DIR" commit -m "[AUTO] image: ${IMAGE_NAME}:${FINAL_IMAGE_TAG}"
              git -C "$GITOPS_DIR" push origin "HEAD:refs/heads/${GITOPS_BRANCH}"
            fi
            echo "GitOps image: ${IMAGE_BASE}:${FINAL_IMAGE_TAG}"
            echo "GitOps commit: $(git -C "$GITOPS_DIR" rev-parse HEAD)"
          '''
        }
      }
    }
  }

  post {
    always {
      deleteDir()
    }
  }
}
