pipeline {
  agent any

  environment {
    // === 사용자 수정 영역 ===
    GIT_URL                = 'https://github.com/parkjingeun01-hue/myfirst-api-server.git'
    GIT_BRANCH             = 'main'            // 또는 main
    GIT_ID                 = 'skala-github-id'   // GitHub PAT credential ID
    IMAGE_NAME             = 'sk051-webserver'
    // =======================
    IMAGE_TAG              = '1.0'
    IMAGE_REGISTRY_URL     = 'skala-registry.skala-us.com'
    IMAGE_REGISTRY_PROJECT = 'class-2'

    DOCKER_CREDENTIAL_ID   = 'skala-image-registry-id'  // Harbor 인증 정보 ID
    K8S_NAMESPACE          = 'class-2'
    DEPLOYMENT_NAME        = 'sk051-myfirst-api-server'  // kustomize/base/deployment.yaml의 metadata.name과 동일해야 함
  }

  options {
    disableConcurrentBuilds()
    timestamps()
    skipDefaultCheckout(true)
    timeout(time: 20, unit: 'MINUTES')
  }

  stages {
    stage('Clone Repository') {
      steps {
        echo 'Clone Repository'
        git branch: "${GIT_BRANCH}", url: "${GIT_URL}", credentialsId: "${GIT_ID}"
        sh 'ls -al'
      }
    }

    stage('Build with Maven') {
      steps {
        echo 'Build with Maven'
        sh 'mvn -s settings.xml clean package -DskipTests'
        // sh 'mvn clean package -DskipTests'
        sh 'ls -al'
      }
    }

    // 로그인/빌드/푸시/정리
    stage('Image Build & Push (Buildah)') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: "${DOCKER_CREDENTIAL_ID}",
          usernameVariable: 'REG_USER',
          passwordVariable: 'REG_PASS'
        )]) {
        sh '''
            set +x
            set -eu
            IMAGE_REF="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}:${IMAGE_TAG}-ba${BUILD_NUMBER}"

            # Use isolated temporary storage and auth; preserve all existing images.
            BUILD_DIR="$(mktemp -d)"
            trap 'rm -rf "$BUILD_DIR"' EXIT
            REGISTRY_AUTH_FILE="$BUILD_DIR/auth.json"
            export REGISTRY_AUTH_FILE
            buildah_local() {
              buildah --storage-driver=vfs --root "$BUILD_DIR/storage" --runroot "$BUILD_DIR/run" "$@"
            }
            printf '%s' "$REG_PASS" | buildah_local login --authfile "$REGISTRY_AUTH_FILE" -u "$REG_USER" --password-stdin "$IMAGE_REGISTRY_URL"
            buildah_local bud --authfile "$REGISTRY_AUTH_FILE" --isolation=chroot --platform linux/amd64 -t "$IMAGE_REF" .
            buildah_local push --authfile "$REGISTRY_AUTH_FILE" "$IMAGE_REF" "docker://$IMAGE_REF"
        '''
        }
      }
    }

    // kustomize/overlays/dev 이미지 태그 업데이트 (git에 올라간 00.spring-backend-v1.0을 clone한 워크스페이스 기준) ───────────────
    stage('Update K8s Manifests') {
      steps {
        sh '''
          set -eu
          test -d ./kustomize/overlays/dev
          cd ./kustomize/overlays/dev

          FINAL_IMAGE_TAG="${IMAGE_TAG}-ba${BUILD_NUMBER}"
          IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"

          kustomize edit set image "${IMAGE_BASE}=${IMAGE_BASE}:${FINAL_IMAGE_TAG}"

          # ===== DEBUG:START =====
          echo "--- AFTER ---"
          cat ./kustomization.yaml
          # ===== DEBUG:END =====
        '''
      }
    }

    // ── Kubernetes 배포 (kustomize build | kubectl apply) ───────────────
    stage('Deploy to Kubernetes') {
      steps {
        sh '''
          set -eu

          FINAL_IMAGE_TAG="${IMAGE_TAG}-ba${BUILD_NUMBER}"
          IMAGE_BASE="${IMAGE_REGISTRY_URL}/${IMAGE_REGISTRY_PROJECT}/${IMAGE_NAME}"

          # ===== DEBUG:START =====
          echo "=== [DEBUG] Deploy to Kubernetes stage ==="
          echo "K8S_NAMESPACE=${K8S_NAMESPACE}"
          echo "DEPLOYMENT_NAME=${DEPLOYMENT_NAME}"
          kubectl version --client 2>&1 | head -1 || echo "kubectl not found!"
          kustomize version 2>&1 | head -1 || echo "kustomize not found!"
          # ===== DEBUG:END =====

          echo "=== kustomize build 결과 적용 ==="
          kustomize build ./kustomize/overlays/dev > rendered-manifests.yaml
          # Only the three reviewed sk051 resources may be applied.
          kubectl apply --dry-run=server -n "${K8S_NAMESPACE}" -f rendered-manifests.yaml -o name > resources-to-apply.txt
          test "$(wc -l < resources-to-apply.txt | tr -d ' ')" = 3
          while IFS= read -r resource; do
            case "$resource" in
              configmap/sk051-backend-configmap|service/sk051-myfirst-api-server|deployment.apps/sk051-myfirst-api-server) ;;
              *) echo "Unexpected resource: $resource"; exit 1 ;;
            esac
          done < resources-to-apply.txt
          kubectl apply -n "${K8S_NAMESPACE}" -f rendered-manifests.yaml

          echo "=== 배포 롤아웃 대기 ==="
          kubectl rollout status deployment/"${DEPLOYMENT_NAME}" \
            -n "${K8S_NAMESPACE}" \
            --timeout=180s

          echo "=== 배포 완료: ${IMAGE_BASE}:${FINAL_IMAGE_TAG} ==="
          kubectl get pods -n "${K8S_NAMESPACE}" -l "app=${DEPLOYMENT_NAME}"
        '''
      }
    }

  }

  post {
    always {
      deleteDir()  // 워크스페이스 정리 (git clone, target/, 빌드 아티팩트)
    }
  }
}
